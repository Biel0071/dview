{
  "name": "@droidview/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DVIEW Admin desktop installer.",
  "main": "src/main.cjs",
  "scripts": {
    "build": "npm --workspace @droidview/shared run build && npm --workspace @droidview/backend run build && npm --workspace @droidview/web-panel run build",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "start": "electron .",
    "dev": "electron ."
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "dotenv": "^16.4.5",
    "electron-is-dev": "^3.0.1",
    "fastify": "^4.28.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.droidview.admin",
    "productName": "DVIEW Admin",
    "directories": {
      "output": "release-mvp"
    },
    "files": [
      "src/**/*",
      {
        "from": "../web-panel/dist",
        "to": "web-panel",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../../artifacts/android",
        "to": "artifacts/android",
        "filter": [
          "*.apk"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "DVIEW-Admin-Setup-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
